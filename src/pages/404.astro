---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found">
  <main id="content" class="stop stop--intro" style="min-height: 100vh; justify-content: center">
    <div class="hero" style="text-align: center; justify-items: center">
      <p class="eyebrow">404</p>
      <h1>This room does not exist</h1>
      <p class="hero__text">The page you were looking for is not part of the house.</p>
      <a class="button" href="/">Back to the house</a>
    </div>
  </main>
</Base>
